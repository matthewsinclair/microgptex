# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
microgptex-*.tar

# Temporary files, for example, from tests.
/tmp/

# Don't check in the escript binary
./arca_cli

# Ignore anything in .arca/data/links as there is no need to check any of that in
.arca/data/links

# Ignore application logs
.arca_cli/logs/

# Ignore any .env files 
.env 
.env.*

# Ignore Intent backups
.backup

# Per-developer Claude Code settings (paths and tool allowlists vary).
.claude/settings.local.json

# AGENTS.md regeneration safety net (intent agents sync writes this; transient).
/AGENTS.md.bak
# Treeindex cache (derived, machine-local; regenerate with 'intent treeindex <dir>').
intent/.treeindex/

# The Intent runtime store: per-machine, rebuilt from the committed extract.
intent/.cache/

# D53: the event log lives in the store; its file form is produced by `intent export`.

# Intent's store snapshots and text exports: per-machine, never committed.
intent/.backup/

# The canon gate's carriers are installed per clone by `intent claude upgrade --apply`
# and never tracked: they are shipped canon, and a tracked copy would be a second home.
.githooks/*.intent
