// Minimal Pandoc Typst template - no page numbering
// Required definitions for Pandoc's markdown conversion

#let horizontalrule = line(length: 100%, stroke: 0.5pt + gray)

// Block quote styling
#show quote: set block(spacing: 1em)
#show quote: set pad(x: 1em)

// Code block styling
#show raw.where(block: true): set block(
  fill: luma(240),
  inset: 1em,
  radius: 3pt,
  width: 100%,
)

$body$
